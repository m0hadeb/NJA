---
import '@/styles/global.css';

const pageTitle = 'Nan Jing Academy';
const navigation = [
  { label: 'דף הבית', href: '#home', section: 'home' },
  { label: 'אודות', href: '#about', section: 'about' },
  { label: 'קורסים', href: '#courses', section: 'courses' },
  { label: 'צור קשר', href: '#contact', section: 'contact' },
];

const aboutCards = [
  { label: 'דרור אומר מוהדב', href: '/about#dror' },
  { label: 'Nan Jing Academy', href: '/about#academy', english: true },
  { label: 'השיטה — TCM 568', href: '/about#method' },
  { label: 'קהילה', href: '/about#community' },
];

const shortCourses = [
  { label: 'איזון הורמונלי', href: '/courses/short#hormonal-balance' },
  { label: 'מערכת העיכול העליונה', href: '/courses/short#upper-digestive' },
  { label: 'דלקות מעיים', href: '/courses/short#intestinal-inflammation' },
  { label: 'פסיכיאטריה ברפואה הסינית', href: '/courses/short#chinese-medicine-psychiatry' },
];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Nan Jing Academy — בית ספר לרפואה סינית ויפנית למטפלים מקצועיים."
    />
    <meta name="theme-color" content="#eee8df" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='22' fill='none' stroke='%236b1a1a' stroke-width='8' stroke-linecap='round' stroke-dasharray='118 24'/%3E%3C/svg%3E"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="paper-canvas text-neutral-950 antialiased">
    <aside class="identity-rail" aria-label="Nan Jing Academy">
      <a href="#home" class="vertical-brand" aria-label="Nan Jing Academy — דף הבית">
        <img
          src="/images/nan-jing-academy-identity-reference.png"
          alt="Nan Jing Academy — 南京中醫學院"
          width="232"
          height="838"
        />
        <span class="rail-title" aria-hidden="true">Nan Jing<br />Academy</span>
      </a>
    </aside>

    <div class="site-content">
      <header class="site-header">
        <a href="#home" class="mobile-brand" aria-label="Nan Jing Academy — דף הבית">
          <img src="/images/nan-jing-academy-logo-v2.png" alt="Nan Jing Academy" />
        </a>

        <nav class="desktop-nav" aria-label="ניווט ראשי">
          {
            navigation.map((item, index) => (
              <a
                href={item.href}
                data-section-link={item.section}
                class:list={{ active: index === 0 }}
                aria-current={index === 0 ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <details class="mobile-menu">
          <summary>
            <span>תפריט</span>
            <span class="menu-lines" aria-hidden="true"></span>
          </summary>
          <nav aria-label="ניווט למובייל">
            {
              navigation.map((item, index) => (
                <a
                  href={item.href}
                  data-section-link={item.section}
                  class:list={{ active: index === 0 }}
                  aria-current={index === 0 ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </details>
      </header>

      <main>
        <section class="page-section hero-section" id="home" data-section="home" aria-label="Nan Jing Academy">
          <div class="hero-frame">
            <video
              class="hero-video"
              src="/videos/nan-jing-academy-home-2026.mp4"
              poster="/images/abdominal-diagnosis-hero.png"
              aria-label="אבחון וטיפול במסגרת Nan Jing Academy"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              הדפדפן שלך אינו תומך בהצגת וידאו.
            </video>
          </div>
        </section>

        <section class="page-section about-section" id="about" data-section="about" aria-labelledby="about-title">
          <div class="section-inner">
            <header class="section-heading">
              <h2 id="about-title">אודות</h2>
            </header>

            <div class="about-grid">
              {
                aboutCards.map((card) => (
                  <a class="paper-card about-card" href={card.href}>
                    <span class="corner-mark" aria-hidden="true"></span>
                    <span class:list={{ 'card-title': true, english: card.english }}>{card.label}</span>
                    <span class="card-arrow" aria-hidden="true">←</span>
                    <span class="seal" aria-hidden="true">學</span>
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        <section class="page-section courses-section" id="courses" data-section="courses" aria-labelledby="courses-title">
          <div class="section-inner">
            <header class="section-heading">
              <h2 id="courses-title">קורסים</h2>
            </header>

            <div class="courses-layout">
              <div class="core-courses">
                <h3>קורס שנתי</h3>
                <div class="core-grid">
                  <a class="paper-card course-card" href="/courses/advanced-a">
                    <span class="corner-mark" aria-hidden="true"></span>
                    <span class="card-title">אבחנות מתקדמות א׳</span>
                    <span class="card-arrow" aria-hidden="true">←</span>
                    <span class="seal" aria-hidden="true">學</span>
                  </a>
                  <a class="paper-card course-card" href="/courses/advanced-b">
                    <span class="corner-mark" aria-hidden="true"></span>
                    <span class="card-title">אבחנות מתקדמות ב׳</span>
                    <span class="card-arrow" aria-hidden="true">←</span>
                    <span class="seal" aria-hidden="true">學</span>
                  </a>
                </div>
              </div>

              <div class="short-courses">
                <h3><a href="/courses/short">קורסים קצרים</a></h3>
                <div class="short-list">
                  {
                    shortCourses.map((course) => (
                      <a class="paper-card short-course" href={course.href}>
                        <span>{course.label}</span>
                        <span class="card-arrow" aria-hidden="true">←</span>
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="page-section contact-section" id="contact" data-section="contact" aria-labelledby="contact-title">
          <div class="section-inner">
            <header class="section-heading">
              <h2 id="contact-title">צור קשר</h2>
            </header>

            <form class="contact-panel" id="contact-form">
              <span class="corner-mark top-right" aria-hidden="true"></span>
              <span class="corner-mark bottom-left" aria-hidden="true"></span>
              <div class="contact-intro">
                <h3>לפרטים נוספים והרשמה</h3>
                <p>השאירו פרטים ונחזור אליכם בהקדם</p>
              </div>

              <div class="social-links" aria-label="רשתות חברתיות ויצירת קשר">
                <button type="button" class="social-link social-link--facebook" aria-label="Facebook — קישור יתווסף בהמשך" title="Facebook">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v2H6v4h3v7h4v-7h3.2l.8-4h-4V9c0-.7.3-1 1-1Z" />
                  </svg>
                  <span>Facebook</span>
                </button>
                <button type="button" class="social-link social-link--instagram" aria-label="Instagram — קישור יתווסף בהמשך" title="Instagram">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="1"></circle>
                  </svg>
                  <span>Instagram</span>
                </button>
                <button type="button" class="social-link social-link--whatsapp" aria-label="WhatsApp — קישור יתווסף בהמשך" title="WhatsApp">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4.1Z"></path>
                    <path d="M8.4 7.5c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.9 2.1c.1.2.1.4-.1.6l-.7.9c-.1.2-.2.3 0 .6.7 1.2 1.6 2.1 2.8 2.7.2.1.4.1.5-.1l1-1.2c.2-.2.4-.2.6-.1l2 .9c.3.1.5.2.5.4 0 .2-.1 1.2-.7 1.8-.6.7-1.5 1-2.4 1-1 0-2.3-.4-4.1-1.4-2.4-1.3-4-3.8-4.1-4-.2-.3-1-1.4-1-2.7 0-1.3.7-2 1-2.4Z"></path>
                  </svg>
                  <span>WhatsApp</span>
                </button>
              </div>

              <div class="form-fields">
                <label>
                  <span>שם מלא</span>
                  <input name="name" type="text" autocomplete="name" required />
                </label>
                <label>
                  <span>אימייל</span>
                  <input name="email" type="email" autocomplete="email" required />
                </label>
                <label>
                  <span>טלפון</span>
                  <input name="phone" type="tel" autocomplete="tel" required />
                </label>
                <label class="message-field">
                  <span>שאלות שיש לך</span>
                  <textarea name="message" rows="4"></textarea>
                </label>
              </div>

              <button class="submit-button" type="submit">שלחו</button>
              <p class="form-status" role="status" aria-live="polite"></p>
              <span class="seal contact-seal" aria-hidden="true">學</span>
            </form>
          </div>
        </section>
      </main>
    </div>

    <script>
      const links = Array.from(document.querySelectorAll('[data-section-link]'));
      const sections = Array.from(document.querySelectorAll('[data-section]'));

      const setActiveSection = (sectionId) => {
        links.forEach((link) => {
          const isActive = link.getAttribute('data-section-link') === sectionId;
          link.classList.toggle('active', isActive);
          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActiveSection(visible.target.id);
        },
        { rootMargin: '-32% 0px -52% 0px', threshold: [0, 0.2, 0.5] },
      );

      sections.forEach((section) => observer.observe(section));

      const heroVideo = document.querySelector('.hero-video');
      if (heroVideo instanceof HTMLVideoElement) {
        const revealVideo = () => heroVideo.classList.add('is-ready');
        heroVideo.playbackRate = 0.78;
        if (heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) revealVideo();
        else heroVideo.addEventListener('loadeddata', revealVideo, { once: true });
      }

      document.querySelectorAll('.mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });

      const form = document.querySelector('#contact-form');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const status = form.querySelector('.form-status');
        if (status) status.textContent = 'הטופס מוכן — החיבור לשליחת הפרטים יתווסף בשלב הבא.';
      });

      const alignHashSection = () => {
        if (!window.location.hash) return;
        const section = document.querySelector(window.location.hash);
        if (section instanceof HTMLElement) section.scrollIntoView({ block: 'start', behavior: 'auto' });
      };

      window.addEventListener('hashchange', () => requestAnimationFrame(alignHashSection));
      requestAnimationFrame(() => requestAnimationFrame(alignHashSection));
    </script>
  </body>
</html>
