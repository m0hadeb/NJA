---
import '@/styles/global.css';

const pageTitle = 'Nan Jing Academy';
const navigation = [
  { label: 'דף הבית', href: '#home', active: true },
  { label: 'אודות', href: '#about' },
  { label: 'קורסים', href: '#courses' },
  { label: 'צור קשר', href: '#contact' },
];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Nan Jing Academy — בית ספר לרפואה סינית ויפנית למטפלים מקצועיים."
    />
    <meta name="theme-color" content="#ebe4da" />
    <title>{pageTitle}</title>
  </head>
  <body class="paper-canvas min-h-svh text-neutral-950 antialiased">
    <div class="home-shell" id="home">
      <aside class="identity-rail" aria-label="Nan Jing Academy">
        <a href="#home" class="vertical-brand" aria-label="Nan Jing Academy — דף הבית">
          <img
            src="/images/nan-jing-academy-vertical-identity.png"
            alt="Nan Jing Academy — 南京中醫學院"
            width="209"
            height="831"
          />
        </a>
      </aside>

      <div class="home-content">
        <header class="site-header">
          <div class="header-inner" dir="ltr">
            <a href="#home" class="brand mobile-brand" aria-label="Nan Jing Academy — דף הבית">
              <img
                src="/images/nan-jing-academy-logo-v2.png"
                alt="Nan Jing Academy"
                width="1395"
                height="375"
              />
            </a>

            <nav class="desktop-nav" aria-label="ניווט ראשי" dir="rtl">
              {
                navigation.map((item) => (
                  <a
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={{ active: item.active }}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>

            <details class="mobile-menu" dir="rtl">
              <summary>
                <span>תפריט</span>
                <span class="menu-lines" aria-hidden="true"></span>
              </summary>
              <nav aria-label="ניווט למובייל">
                {
                  navigation.map((item) => (
                    <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </details>
          </div>
        </header>

        <main class="hero-stage">
          <div class="burgundy-horizon" aria-hidden="true"></div>

          <section class="hero-layout" aria-label="Nan Jing Academy" dir="ltr">
            <div class="photo-column">
              <figure class="photo-frame">
                <img
                  src="/images/abdominal-acupuncture-hero.jpg"
                  alt="טיפול בדיקור בטן במסגרת הרפואה הסינית"
                  width="968"
                  height="632"
                  fetchpriority="high"
                />
                <figcaption class="photo-copy" dir="rtl">
                  <h1>לעצור לדמיין</h1>
                  <p>ולהתחיל להרגיש את הגוף</p>
                </figcaption>
              </figure>
              <p class="academy-signature">Nan Jing Academy</p>
              <a class="scroll-cue" href="#about" aria-label="גלילה לחלק הבא">
                <span aria-hidden="true"></span>
              </a>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
