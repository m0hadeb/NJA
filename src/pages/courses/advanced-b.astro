---
import CourseShell from '@/layouts/CourseShell.astro';
---

<CourseShell
  title="אבחנות מתקדמות ב׳"
  description="אבחנות מתקדמות ב׳ — קורס שנתי של Nan Jing Academy."
>
  <section class="page-section course-detail-section alternate" aria-labelledby="advanced-b-title">
    <div class="course-detail-accent" aria-hidden="true"></div>
    <div class="course-detail-inner">
      <p class="course-detail-eyebrow">קורס שנתי</p>
      <h1 id="advanced-b-title">אבחנות מתקדמות ב׳</h1>
      <div class="course-detail-rule" aria-hidden="true"></div>
      <p class="course-detail-placeholder">כאן נוסיף את פרטי הקורס, תוכנית הלימודים, מועדים ופרטי הרשמה.</p>
      <a class="course-back-link" href="/#courses">חזרה לכל הקורסים</a>
      <span class="seal course-detail-seal" aria-hidden="true">學</span>
    </div>
  </section>
</CourseShell>
