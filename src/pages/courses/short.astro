---
import CourseShell from '@/layouts/CourseShell.astro';

const shortCourses = [
  { id: 'hormonal-balance', title: 'איזון הורמונלי' },
  { id: 'upper-digestive', title: 'מערכת העיכול העליונה' },
  { id: 'intestinal-inflammation', title: 'דלקות מעיים' },
  { id: 'chinese-medicine-psychiatry', title: 'פסיכיאטריה ברפואה הסינית' },
];
---

<CourseShell
  title="קורסים קצרים"
  description="הקורסים הקצרים של Nan Jing Academy, לפי סדר תוכנית הלימודים."
>
  {
    shortCourses.map((course, index) => (
      <section
        class:list={{ 'page-section': true, 'course-detail-section': true, alternate: index % 2 === 1 }}
        id={course.id}
        aria-labelledby={`${course.id}-title`}
      >
        <div class="course-detail-accent" aria-hidden="true"></div>
        <div class="course-detail-inner">
          <p class="course-detail-eyebrow">קורסים קצרים</p>
          <h1 id={`${course.id}-title`}>{course.title}</h1>
          <div class="course-detail-rule" aria-hidden="true"></div>
          <p class="course-detail-placeholder">כאן נוסיף את תוכן הקורס, מועדים, היקף הלימודים ופרטי ההרשמה.</p>
          <a class="course-back-link" href="/#courses">חזרה לכל הקורסים</a>
          <span class="seal course-detail-seal" aria-hidden="true">學</span>
        </div>
      </section>
    ))
  }
</CourseShell>
