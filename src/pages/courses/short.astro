---
import CourseShell from '@/layouts/CourseShell.astro';
import ContentDetailSection from '@/components/ContentDetailSection.astro';
import { getContentPages, renderCmsBody } from '@/lib/cms';

const shortCourses = [
  { id: 'hormonal-balance', pageKey: 'course-short-hormonal', title: 'איזון הורמונלי' },
  { id: 'upper-digestive', pageKey: 'course-short-upper-digestive', title: 'מערכת העיכול העליונה' },
  { id: 'intestinal-inflammation', pageKey: 'course-short-intestinal', title: 'דלקות מעיים' },
  { id: 'chinese-medicine-psychiatry', pageKey: 'course-short-psychiatry', title: 'פסיכיאטריה ברפואה הסינית' },
];

const cmsPages = await getContentPages(shortCourses.map((course) => course.pageKey));
const cmsByKey = new Map(cmsPages.map((page) => [page.pageKey, page]));
---

<CourseShell
  title="קורסים קצרים"
  description="הקורסים הקצרים של Nan Jing Academy, לפי סדר תוכנית הלימודים."
>
  {
    shortCourses.map((course) => {
      const cmsPage = cmsByKey.get(course.pageKey);
      return (
        <ContentDetailSection
          id={course.id}
          title={cmsPage?.title ?? course.title}
          eyebrow={cmsPage?.eyebrow ?? 'קורסים קצרים'}
          body="כאן נוסיף את תוכן הקורס, מועדים, היקף הלימודים ופרטי ההרשמה."
          bodyHtml={renderCmsBody(cmsPage)}
          imageSrc={cmsPage?.imageUrl}
          imageAlt={cmsPage?.imageAlt ?? ''}
          videoSrc={cmsPage?.videoFileUrl ?? cmsPage?.videoUrl}
          imageCaption={cmsPage?.mediaCaption}
          backHref="/#courses"
          backLabel="חזרה לכל הקורסים"
        />
      );
    })
  }
</CourseShell>
