---
interface Props {
  id?: string;
  dataSection?: string;
  title: string;
  eyebrow: string;
  body: string;
  bodyHtml?: string;
  english?: boolean;
  imageSrc?: string;
  imageAlt?: string;
  imageCaption?: string;
  videoSrc?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  id,
  dataSection,
  title,
  eyebrow,
  body,
  bodyHtml,
  english = false,
  imageSrc,
  imageAlt = '',
  imageCaption = 'כאן תיכנס התמונה או הווידאו שילוו את הכתבה',
  videoSrc,
  backHref,
  backLabel = 'חזרה',
} = Astro.props;

const titleId = `${id ?? title.toLowerCase().replace(/\s+/g, '-')}-title`;
---

<section class="page-section content-detail-section" id={id} data-section={dataSection} aria-labelledby={titleId}>
  <div class="content-detail-inner">
    <article class="content-detail-copy">
      <p class="content-detail-eyebrow">{eyebrow}</p>
      <h1 class:list={{ 'content-detail-title': true, english }} id={titleId}>{title}</h1>
      <div class="content-detail-rule" aria-hidden="true"></div>
      {
        bodyHtml ? (
          <div class="content-detail-body content-rich-text" set:html={bodyHtml} />
        ) : (
          <p class="content-detail-body">{body}</p>
        )
      }
      {
        backHref && (
          <a class="content-detail-back" href={backHref}>{backLabel}</a>
        )
      }
    </article>

    <figure class="content-detail-media">
      {
        videoSrc ? (
          <video controls playsinline preload="metadata" poster={imageSrc}>
            <source src={videoSrc} />
            הדפדפן שלך אינו תומך בהצגת וידאו.
          </video>
        ) : imageSrc ? (
          <img src={imageSrc} alt={imageAlt} loading="lazy" />
        ) : (
          <div class="content-image-placeholder" role="img" aria-label={`מקום לתמונה או וידאו עבור ${title}`}>
            <span aria-hidden="true">תמונה / וידאו</span>
          </div>
        )
      }
      <figcaption>{imageCaption}</figcaption>
    </figure>

    <span class="seal content-detail-seal" aria-hidden="true">
      <span class="seal-column">南京中</span>
      <span class="seal-column">醫學院</span>
    </span>
  </div>
</section>
